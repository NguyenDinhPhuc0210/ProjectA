# Development environment variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

DB_URL=jdbc:mysql://localhost:3306/bookshop_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# JWT — must be at least 32 characters (256 bits)
JWT_SECRET=CHANGE_ME_to_a_random_32+_char_secret_key

ADMIN_EMAIL=admin@bookshop.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Super Admin

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

CORS_ALLOWED_ORIGINS=http://localhost:5173

SPRING_PROFILES_ACTIVE=dev
