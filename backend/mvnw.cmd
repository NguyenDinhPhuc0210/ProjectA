@REM Maven Wrapper Script (Windows)
@REM Generated by Maven Wrapper Plugin

@echo off
setlocal

set JAVA_EXEC=java
if defined JAVA_HOME set JAVA_EXEC=%JAVA_HOME%\bin\java

set WRAPPER_JAR=.mvn\wrapper\maven-wrapper.jar
set WRAPPER_PROPS=.mvn\wrapper\maven-wrapper.properties

if not exist "%WRAPPER_JAR%" (
    echo Downloading Maven Wrapper...
    for /f "tokens=2 delims==" %%a in ('findstr /i "wrapperUrl" "%WRAPPER_PROPS%"') do set WRAPPER_URL=%%a
    powershell -Command "Invoke-WebRequest -Uri '%WRAPPER_URL%' -OutFile '%WRAPPER_JAR%'"
)

%JAVA_EXEC% -jar "%WRAPPER_JAR%" %*
endlocal
