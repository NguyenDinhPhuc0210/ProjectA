#!/bin/sh
# Maven Wrapper Script (Unix)
# Generated by Maven Wrapper Plugin

if [ -z "$JAVA_HOME" ] ; then
  JAVACMD=`which java`
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

JAR=".mvn/wrapper/maven-wrapper.jar"
PROPERTIES=".mvn/wrapper/maven-wrapper.properties"

if [ -f "$JAR" ]; then
    exec "$JAVACMD" -jar "$JAR" "$@"
else
    # Download wrapper jar
    DOWNLOAD_URL=$(grep 'wrapperUrl' "$PROPERTIES" | cut -d'=' -f2)
    echo "Downloading Maven Wrapper from $DOWNLOAD_URL"
    if command -v curl > /dev/null; then
        curl -o "$JAR" "$DOWNLOAD_URL" -s
    elif command -v wget > /dev/null; then
        wget "$DOWNLOAD_URL" -O "$JAR"
    fi
    exec "$JAVACMD" -jar "$JAR" "$@"
fi
